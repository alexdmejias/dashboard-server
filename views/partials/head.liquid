<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% if tailwindCss != blank %}<style>{{ tailwindCss }}</style>{% endif %}
  <link rel="stylesheet" href="https://usetrmnl.com/css/3.2.0/plugins.css">

  <style>
    .trmnl .screen--inkplate_10 {
      --screen-w: 1200px;
      --screen-h: 825px;
      --screen-w-original: 1200px;
      --screen-h-original: 825px;
      --title-font-size: 30px
    }

    .trmnl .screen--2bit .item .meta {
      background-image: url("https://usetrmnl.com/images/grayscale--2bit/gray-10.png");
    }
    .screen {
      border: 1px solid tomato;
    }

    /* ── Status bars: fixed 40px bands at the top and bottom of the screen ── */
    .trmnl .screen {
      position: relative;
      --status-bar-h: 40px;
    }

    .status-bar {
      position: absolute;
      left: 0;
      right: 0;
      z-index: 10;
      height: var(--status-bar-h);
      box-sizing: border-box;
      padding: 0 16px;
      display: flex;
      align-items: center;
      gap: 16px;
      background: #fff;
      color: #000;
      font-family: inherit;
      font-size: 20px;
      line-height: 1;
      white-space: nowrap;
      overflow: hidden;
    }

    .status-bar--top {
      top: 0;
      border-bottom: 2px solid #000;
    }

    .status-bar--bottom {
      bottom: 0;
      border-top: 2px solid #000;
    }

    .status-bar__start,
    .status-bar__end {
      flex: 1 1 0;
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .status-bar__end {
      justify-content: flex-end;
    }

    .status-bar__center {
      flex: 0 0 auto;
    }

    .status-bar__text {
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .status-bar__strong {
      font-weight: 700;
    }

    .status-bar__icon {
      width: 32px;
      height: 32px;
      flex: 0 0 auto;
    }

    .status-bar__updated {
      flex: 0 0 auto;
      padding-left: 12px;
      border-left: 2px solid #000;
    }

    .status-bar__spacer {
      visibility: hidden;
    }
  </style>
  <title>Document</title>
</head>

<body>
<div class="trmnl">
  <div class="screen screen--2bit screen--inkplate_10 screen--md screen--1x">

