{% comment %}
  Tailwind only (see reddit/template.liquid for why gaps are `!important`).
  Sized for a half column by default; `in-[.view--full]:` scales it up.
  Example sentences only show full screen, to leave room for definitions.
{% endcomment %}
<div class="flex min-h-0 flex-1 flex-col justify-center gap-4! overflow-hidden p-6 font-['Inter_Variable',Inter] in-[.view--full]:gap-6! in-[.view--full]:p-12">
  {% if runtimeConfig.title %}
    <span class="block text-[20px] font-semibold uppercase tracking-[0.15em] in-[.view--full]:text-[24px]">{{ runtimeConfig.title }}</span>
  {% endif %}
  <div class="flex flex-row flex-wrap items-baseline gap-x-4! gap-y-1!">
    <h1 class="text-[64px] font-bold leading-none in-[.view--full]:text-[96px]">{{ data.word }}</h1>
    {% if data.pronunciation %}
      <span class="text-[24px] in-[.view--full]:text-[32px]">{{ data.pronunciation }}</span>
    {% endif %}
    {% if data.partOfSpeech %}
      <span class="text-[24px] italic in-[.view--full]:text-[32px]">{{ data.partOfSpeech }}</span>
    {% endif %}
  </div>
  <div class="h-[3px] w-full shrink-0 rounded-full bg-black"></div>
  {% if data.definitions.size > 0 %}
    <ol class="flex list-inside list-decimal flex-col gap-2! text-[28px] leading-[1.3] in-[.view--full]:gap-3! in-[.view--full]:text-[36px]">
      {% for definition in data.definitions %}
        <li>{{ definition }}</li>
      {% endfor %}
    </ol>
  {% endif %}
  {% if data.sentences.size > 0 %}
    <div class="flex flex-col gap-2! text-[28px] italic leading-[1.3] not-in-[.view--full]:hidden!">
      {% for sentence in data.sentences %}
        <p>&ldquo;{{ sentence }}&rdquo;</p>
      {% endfor %}
    </div>
  {% endif %}
</div>
